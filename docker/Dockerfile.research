FROM ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7 AS native

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates cmake ninja-build git ccache rsync curl \
    python3 python3-dev python3-pip python3-venv pkg-config \
    libboost-all-dev libgsl-dev libsqlite3-dev libxml2-dev libopencv-dev \
    libgrpc++-dev libprotobuf-dev protobuf-compiler protobuf-compiler-grpc \
    libgl1 libegl1 libgtk-3-dev libssh-dev llvm-14 libllvm14 \
    sumo sumo-tools iproute2 lsof unzip \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /bin/bash researcher \
 && mkdir -p /research && chown researcher:researcher /research
WORKDIR /research
USER researcher

FROM native AS final
USER root
RUN python3 -m pip install --upgrade 'pip==25.1.1' \
 && python3 -m pip install \
    'tensorflow[and-cuda]==2.18.1' 'sionna==1.0.0' \
    'matplotlib==3.10.1' 'pandas==2.2.3' 'scipy==1.14.1' \
    'PyYAML==6.0.2' 'grpcio==1.71.0' 'pytest==8.3.5'

WORKDIR /research
USER researcher
CMD ["bash"]
